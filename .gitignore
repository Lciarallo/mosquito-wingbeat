# Este repositório publica apenas: o caderno (única fonte da verdade), a apresentação e a lista de dependências.
/*
!/.gitignore
!/.gitattributes
!/.nojekyll
!/README.md
!/requirements.txt
!/notebooks/
!/apresentacao/
!/data/

# Metadados mínimos que o caderno lê (os áudios em si não são publicados).
/data/*
!/data/metadata/
/data/metadata/*
!/data/metadata/ternary_segments.csv.gz
!/data/metadata/known_recording_groups.csv

/notebooks/*
!/notebooks/detector_ternario_treinamento_teste_aplicacao.ipynb

# Dados, caches e saídas locais nunca são publicados.
/cache_notebook/
/data/raw/
/data/archives/
/data/external/
/data/noise/
__pycache__/
.ipynb_checkpoints/
*.py[cod]
*.log
.DS_Store
